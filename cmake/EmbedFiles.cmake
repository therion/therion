# Converts files into a C++ source with byte arrays.
# Usage: cmake -DOUTPUT=<file.cxx> -DFILES=<symbol>=<path>,... -P EmbedFiles.cmake
set(content "// Generated by cmake/EmbedFiles.cmake -- do not edit.\n#include <cstddef>\n")
string(REPLACE "," ";" FILES "${FILES}")
foreach(item IN LISTS FILES)
    string(FIND "${item}" "=" pos)
    string(SUBSTRING "${item}" 0 ${pos} symbol)
    math(EXPR pos "${pos} + 1")
    string(SUBSTRING "${item}" ${pos} -1 path)
    file(READ "${path}" hex HEX)
    string(LENGTH "${hex}" len)
    math(EXPR size "${len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    string(REGEX REPLACE "((0x..,){32})" "\\1\n" hex "${hex}")
    string(APPEND content "extern const unsigned char ${symbol}[] = {\n${hex}0};\n")
    string(APPEND content "extern const size_t ${symbol}_size = ${size};\n")
endforeach()
file(WRITE "${OUTPUT}" "${content}")
